# npm 10 and 11 crash ("Cannot read properties of null (reading 'edgesOut')")
# while resolving vitest 4's peer dependencies. Skipping automatic peer
# installation avoids it; every peer the project needs (vite, @types/node,
# jsdom, @vitest/coverage-v8) is already a direct or regular dependency.
# Remove this line once `npm install` works without it.
legacy-peer-deps=true
